# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# CASHFREE PAYMENT GATEWAY CONFIGURATION
# ========================================================
# Cashfree App ID / Client ID (from Cashfree Merchant Dashboard)
CASHFREE_APP_ID="TEST_YOUR_CASHFREE_APP_ID"

# Cashfree Secret Key (keep secure on server-side only)
CASHFREE_SECRET_KEY="TEST_YOUR_CASHFREE_SECRET_KEY"

# Environment: TEST (Sandbox) or PROD (Production)
CASHFREE_ENV="TEST"

# Cashfree PG API Version
CASHFREE_API_VERSION="2023-08-01"

# ========================================================
# MSG91 & JIO DLT SMS GATEWAY CONFIGURATION
# ========================================================
# MSG91 Auth Key (from MSG91 Dashboard)
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"

# MSG91 OTP Template ID / Flow ID
MSG91_OTP_TEMPLATE_ID="YOUR_MSG91_OTP_TEMPLATE_ID"

# Jio DLT Approved Header / Sender ID (6 characters, e.g. TWLRSH, RASHID)
MSG91_SENDER_ID="TWLRSH"

# Jio DLT Principal Entity ID (Registered on Jio DLT portal)
JIO_DLT_ENTITY_ID="1101452890000012345"

# Jio DLT Content Template ID for OTP Verification SMS
JIO_DLT_TEMPLATE_ID="1107161829482718293"
